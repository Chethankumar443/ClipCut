---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
}

const {
  title = "ClipCut — Turn Long Videos Into Viral Shorts, Reels & TikToks Free",
  description = "Drop a YouTube, Twitch, or Kick link and extract viral vertical 9:16 clips automatically. Free, open-source OpusClip alternative with Faster-Whisper in 99+ languages, vocal peak detection, and zero watermarks.",
  keywords = "AI video clipper, free OpusClip alternative, open source AI Shorts generator, auto TikTok clip maker, Instagram Reels clip generator, Twitch stream auto clipper, Kick VOD clipper, Faster-Whisper captions, viral hook detector, self-hosted video studio",
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? "https://clip-cut-alpha.vercel.app").toString();
const siteOrigin = new URL("/", Astro.site ?? "https://clip-cut-alpha.vercel.app").toString().replace(/\/+$/, "");

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "ClipCut",
    url: siteOrigin,
    description,
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "ClipCut",
    applicationCategory: "MultimediaApplication",
    operatingSystem: "Windows, macOS, Linux, Docker",
    url: siteOrigin,
    downloadUrl: "https://github.com/Chethankumar443/ClipCut",
    license: "https://opensource.org/licenses/MIT",
    description,
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD",
    },
    featureList: [
      "Turn YouTube, Twitch, Kick VODs, and local recordings into captioned 9:16 vertical Shorts",
      "YouTube Most-Replayed viewer heatmap and librosa vocal energy hook detection",
      "Single multi-language Faster-Whisper speech recognition with auto language detection (99+ languages)",
      "Playhead-synced word editor with animated Bounce, Hype, and Clean captions",
      "Gaming Mode for 23+ games with automatic facecam framing and BGM sidechain ducking",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "What does ClipCut cost?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "ClipCut is 100% free and MIT-licensed. Bring your own API key (Gemini, OpenAI, Claude, Grok, Groq, OpenRouter) or run completely free locally with Ollama.",
        },
      },
      {
        "@type": "Question",
        name: "Which video sources and languages does ClipCut support?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Paste YouTube, Twitch, or Kick links, upload local video files, or monitor live streams. Faster-Whisper automatically detects and transcribes 99+ languages from one model.",
        },
      },
    ],
  },
];
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Chethan Kumar Jagadish Ulavi" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#000000" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />
    <link rel="icon" type="image/svg+xml" href="/brand/favicon.svg?v=3" />

    <!-- Open Graph -->
    <meta property="og:site_name" content="ClipCut" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`${siteOrigin}/brand/clipcut-logo.png`} />
    <meta property="og:image:alt" content="ClipCut Open-Source AI Video Clipping Studio" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteOrigin}/brand/clipcut-logo.png`} />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-black text-foreground antialiased selection:bg-[#ff7a2f]/30 selection:text-white">
    <slot />
  </body>
</html>
