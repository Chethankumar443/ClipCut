---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "ClipCut — AI Video Clipping Studio",
  description = "Turn Twitch, Kick, and YouTube live streams, podcasts, and long-form videos into captioned, publish-ready vertical clips. Free, open source, and self-hosted.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#09090B" />
    <link rel="icon" type="image/svg+xml" href="/brand/favicon.svg?v=3" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-background text-foreground antialiased selection:bg-[#ff7a2f]/30 selection:text-white">
    <slot />
  </body>
</html>
