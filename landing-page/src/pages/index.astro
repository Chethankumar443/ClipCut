---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar";
import Footer from "../components/Footer";
import VideoShowcase from "../components/VideoShowcase";
import ScrollExpand from "../components/react-bits/ScrollExpand";
import StudioPipeline from "../components/StudioPipeline";
import ValueProposition from "../components/ValueProposition";
import FaqAccordion from "../components/FaqAccordion";
import Lightfall from "../components/react-bits/Lightfall";
import CurvedLoop from "../components/react-bits/CurvedLoop";
import AnimatedContent from "../components/react-bits/AnimatedContent";
import Magnet from "../components/react-bits/Magnet";
import { Badge } from "../components/ui/badge";
import { TextEffect } from "../components/motion-primitives/TextEffect";
import { InView } from "../components/motion-primitives/InView";
import { BorderTrail } from "../components/motion-primitives/BorderTrail";
import SpecularButton from "../components/react-bits/SpecularButton";
import { ArrowRight, Github, Terminal } from "lucide-react";
---

<Layout>
  <div id="top" class="relative min-h-screen overflow-x-clip bg-black">
    <!-- 1. Hero with Lightfall WebGL2 Header (Hero ambiance preserved) -->
    <div class="relative overflow-x-clip border-b border-white/10 bg-[#0d0a08]">
      <div class="pointer-events-none absolute inset-0 z-0 overflow-hidden opacity-85">
        <Lightfall
          client:load
          colors={["#fbf7f2", "#ff7a2f", "#ffb07a"]}
          backgroundColor="#ff7a2f"
          speed={0.28}
          streakCount={3}
          streakWidth={0.85}
          twinkle={0.3}
          backgroundGlow={0.14}
          headGlow={0.65}
          bloom={0.35}
          fade={0.35}
          mouseInteraction
          holdToWarp
          intro
        />
      </div>

      <div class="relative z-10 pt-1">
        <Navbar client:load active="home" />

        <section class="relative mx-auto flex min-h-[calc(100vh-5.5rem)] max-w-7xl items-center px-5 pt-14 pb-20 sm:px-6 md:pt-20 md:pb-24">
          <div class="grid w-full grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-12">
            <div class="text-left lg:col-span-7">
              <Badge variant="default" className="text-[11px] font-semibold uppercase tracking-[0.14em] tabular-nums">
                $0/mo Open Source · Zero Watermarks
              </Badge>

              <TextEffect
                client:load
                as="h1"
                per="word"
                delay={50}
                text="One link in. Viral Shorts out."
                className="mt-6 max-w-3xl font-serif text-5xl leading-[1.0] tracking-tight text-[#fbf7f2] sm:text-7xl lg:text-[84px]"
              />

              <InView client:load delay={120}>
                <p class="mt-6 max-w-xl text-base leading-relaxed text-[#d4c8be] sm:text-lg lg:text-xl">
                  Stop scrubbing 4-hour VODs by hand. Paste a YouTube, Twitch, or Kick link—ClipCut
                  transcribes in 99+ languages, locks onto replay &amp; hype peaks, writes scroll-stopping
                  hooks, and renders captioned 9:16 reels locally.
                </p>
              </InView>

              <div class="mt-9 flex flex-wrap items-center gap-3.5 sm:gap-4">
                <Magnet client:load>
                  <SpecularButton
                    client:load
                    href="/docs/quickstart"
                    size="lg"
                    radius={999}
                    tint="#ff7a2f"
                    tintOpacity={0.22}
                    textColor="#fbf7f2"
                    lineColor="#ffb07a"
                    baseColor="#ff7a2f"
                    intensity={1.15}
                    idleIntensity={0.45}
                    glow={1.15}
                    blur={8}
                  >
                    <span>Get Started</span>
                    <ArrowRight className="h-4 w-4 text-[#ff9a5c]" />
                  </SpecularButton>
                </Magnet>

                <SpecularButton
                  client:load
                  href="/docs"
                  size="lg"
                  radius={999}
                  tint="#ffffff"
                  tintOpacity={0.05}
                  textColor="#fbf7f2"
                  lineColor="#fff4e8"
                  baseColor="#52463d"
                  intensity={0.9}
                  idleIntensity={0.3}
                  blur={8}
                >
                  <span>Documentation</span>
                </SpecularButton>

                <SpecularButton
                  client:load
                  href="https://github.com/Chethankumar443/ClipCut"
                  target="_blank"
                  rel="noopener noreferrer"
                  size="lg"
                  radius={999}
                  tint="#ffffff"
                  tintOpacity={0.02}
                  textColor="#d7cbc0"
                  lineColor="#fff4e8"
                  baseColor="#3a312b"
                  intensity={0.8}
                  idleIntensity={0.25}
                >
                  <Github className="h-4 w-4" />
                  <span>GitHub</span>
                </SpecularButton>
              </div>
            </div>

            <div class="flex items-center justify-center lg:col-span-5">
              <VideoShowcase client:load />
            </div>
          </div>
        </section>
      </div>
    </div>

    <main class="bg-black">
      <!-- 2. CurvedLoop Arc Marquee -->
      <section class="border-b border-white/10 bg-black">
        <CurvedLoop
          client:visible
          marqueeText="ZERO WATERMARKS · YOUTUBE SHORTS · REELS · TIKTOK · 99+ LANGUAGES · TWITCH · KICK · LOCAL & FREE ·"
          shape="arc"
          speed={1.15}
          curveAmount={112}
          fontSize={36}
          fontWeight={600}
          letterSpacing="0.08em"
          color="#dfd5cc"
          separator="·"
          separatorColor="#ff7a2f"
          edgeFade={0.22}
        />
      </section>

      <!-- 3. Visual Product Proof: ScrollExpand Showcase -->
      <section class="mx-auto max-w-6xl bg-black px-5 pt-16 pb-10 sm:px-6 sm:pt-20">
        <ScrollExpand
          client:load
          src="/brand/raygan-unscripted-loop.mp4"
          mediaType="video"
          title="Hook viewers in 1.5s."
          scrollHint="Scroll to reveal clip"
          startWidth={56}
          startHeight={64}
          mediaZoom={1.1}
          scrollDistance={0.8}
          holdDistance={0.18}
          useWindowScroll
        >
          <h2 class="font-serif text-4xl text-[#fbf7f2] sm:text-5xl">
            Captions that hold attention. Framing that converts.
          </h2>
          <p class="mt-3 max-w-lg text-sm text-[#d7cbc0] sm:text-base">
            Multi-language Faster-Whisper captions, librosa energy spikes, and your AI hook score—rendered directly on your machine.
          </p>
        </ScrollExpand>
      </section>

      <!-- 4. Interactive 6-Stage Studio Pipeline (Full-Screen CircularGallery) -->
      <StudioPipeline client:idle />

      <!-- 5. Why ClipCut: Problem, Investment (Time & Money), Solution & Comparison -->
      <ValueProposition client:visible />

      <!-- 6. Quick Start & FAQ -->
      <AnimatedContent client:visible distance={44} duration={0.75} stagger={0.1}>
        <section id="quickstart" class="mx-auto max-w-6xl bg-black px-5 py-16 sm:px-6 sm:py-24">
          <div class="relative overflow-hidden rounded-3xl border border-white/12 bg-[#060606] p-7 sm:p-12">
            <BorderTrail client:visible />
            <div class="relative z-10 grid gap-10 lg:grid-cols-2 lg:items-center">
              <div>
                <div class="inline-flex items-center gap-2 text-xs font-semibold tracking-[0.12em] text-[#ff7a2f] uppercase">
                  <Terminal className="h-4 w-4" />
                  <span>Quick Start</span>
                </div>
                <h2 class="mt-3 font-serif text-3xl tracking-tight text-[#fbf7f2] sm:text-4xl">
                  Launch your clip studio in under a minute.
                </h2>
                <p class="mt-4 text-sm leading-relaxed text-[#a1a1aa]">
                  Runs on Python 3.10+ (FFmpeg bundles automatically via{" "}
                  <code class="rounded bg-white/10 px-1.5 py-0.5 text-[13px] font-medium text-[#fbf7f2]">static-ffmpeg</code>) or spin up the full
                  stack with <code class="rounded bg-white/10 px-1.5 py-0.5 text-[13px] font-medium text-[#fbf7f2]">docker compose up -d --build</code>.
                </p>
                <div class="mt-6">
                  <a
                    href="/docs/quickstart"
                    class="inline-flex items-center gap-2 text-sm font-semibold text-[#ff7a2f] transition-colors hover:text-[#ff904d]"
                  >
                    <span>Full installation and Docker guide</span>
                    <ArrowRight className="h-4 w-4" />
                  </a>
                </div>
              </div>

              <div class="overflow-x-auto rounded-2xl border border-white/10 bg-black p-5 text-xs font-medium leading-7 text-[#e4dad0] sm:p-6 sm:text-sm">
                <div><span class="text-[#71717a]"># Clone into a short path (e.g. C:\clipcut or ~/clipcut)</span></div>
                <div>git clone https://github.com/Chethankumar443/ClipCut.git ~/clipcut</div>
                <div>cd ~/clipcut &amp;&amp; pip install -r requirements.txt</div>
                <div class="text-[#ff9a5c]">python -m studio.server</div>
              </div>
            </div>
          </div>
        </section>

        <section id="faq" class="mx-auto max-w-3xl bg-black px-5 py-16 sm:px-6 sm:py-20">
          <div class="mb-10 text-center">
            <p class="text-xs font-semibold tracking-[0.16em] text-[#ff7a2f] uppercase">
              Questions &amp; Answers
            </p>
            <h2 class="mt-2 font-serif text-4xl tracking-tight text-[#fbf7f2]">
              No paywalls. No secrets.
            </h2>
            <p class="mt-3 text-sm text-[#a1a1aa]">
              Everything you want to know before ditching cloud clipping subscriptions.
            </p>
          </div>
          <FaqAccordion client:visible />
        </section>
      </AnimatedContent>
    </main>

    <Footer client:visible />
  </div>
</Layout>
