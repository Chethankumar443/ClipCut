---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar";
import Footer from "../components/Footer";
import VideoShowcase from "../components/VideoShowcase";
import StudioPipeline from "../components/StudioPipeline";
import FaqAccordion from "../components/FaqAccordion";
import Lightfall from "../components/react-bits/Lightfall";
import CurvedLoop from "../components/react-bits/CurvedLoop";
import ScrollExpand from "../components/react-bits/ScrollExpand";
import AnimatedContent from "../components/react-bits/AnimatedContent";
import Magnet from "../components/react-bits/Magnet";
import CountUp from "../components/react-bits/CountUp";
import { Badge } from "../components/ui/badge";
import { TextEffect } from "../components/motion-primitives/TextEffect";
import { InView } from "../components/motion-primitives/InView";
import { BorderTrail } from "../components/motion-primitives/BorderTrail";
import SpecularButton from "../components/react-bits/SpecularButton";
import { ArrowRight, Github, Terminal } from "lucide-react";
---

<Layout>
  <div id="top" class="relative min-h-screen overflow-x-clip bg-[#0d0a08]">
    <!-- Hero with Lightfall WebGL2 Header -->
    <div class="relative overflow-x-clip">
      <div class="pointer-events-none absolute inset-0 z-0 overflow-hidden opacity-85">
        <Lightfall
          client:load
          colors={["#fbf7f2", "#ff7a2f", "#ffb07a"]}
          backgroundColor="#ff7a2f"
          speed={0.28}
          streakCount={3}
          streakWidth={0.85}
          twinkle={0.3}
          backgroundGlow={0.14}
          headGlow={0.65}
          bloom={0.35}
          fade={0.35}
          mouseInteraction
          holdToWarp
          intro
        />
      </div>

      <div class="relative z-10 pt-1">
        <Navbar client:load active="home" />

        <section class="relative mx-auto flex min-h-[calc(100vh-5.5rem)] max-w-7xl items-center px-6 pt-16 pb-24 md:pt-20 md:pb-28">
          <div class="grid w-full grid-cols-1 items-center gap-14 lg:grid-cols-12 lg:gap-12">
            <div class="text-left lg:col-span-7">
              <Badge variant="default" className="font-mono text-[11px] uppercase tracking-wider">
                Open Source · Self-Hosted Studio
              </Badge>

              <TextEffect
                client:load
                as="h1"
                per="word"
                delay={50}
                text="Cut the noise. Keep the moment."
                className="mt-6 max-w-3xl font-serif text-5xl leading-[1.0] tracking-tight text-[#fbf7f2] sm:text-7xl lg:text-[84px]"
              />

              <InView client:load delay={120}>
                <p class="mt-7 max-w-xl text-base leading-relaxed text-[#b5a79c] sm:text-lg lg:text-xl">
                  Paste a YouTube, Twitch, or Kick link or drop in a local file. ClipCut transcribes
                  speech, detects vocal energy and Most-Replayed peaks, scores hooks with your AI key,
                  and renders captioned vertical clips locally.
                </p>
              </InView>

              <div class="mt-10 flex flex-wrap items-center gap-4">
                <Magnet client:load>
                  <SpecularButton
                    client:load
                    href="/docs/quickstart"
                    size="lg"
                    radius={999}
                    tint="#ff7a2f"
                    tintOpacity={0.22}
                    textColor="#fbf7f2"
                    lineColor="#ffb07a"
                    baseColor="#ff7a2f"
                    intensity={1.15}
                    idleIntensity={0.45}
                    glow={1.15}
                    blur={8}
                  >
                    <span>Get Started</span>
                    <ArrowRight className="h-4 w-4 text-[#ff9a5c]" />
                  </SpecularButton>
                </Magnet>

                <SpecularButton
                  client:load
                  href="/docs"
                  size="lg"
                  radius={999}
                  tint="#ffffff"
                  tintOpacity={0.05}
                  textColor="#fbf7f2"
                  lineColor="#fff4e8"
                  baseColor="#52463d"
                  intensity={0.9}
                  idleIntensity={0.3}
                  blur={8}
                >
                  <span>Documentation</span>
                </SpecularButton>

                <SpecularButton
                  client:load
                  href="https://github.com/Chethankumar443/ClipCut"
                  target="_blank"
                  rel="noopener noreferrer"
                  size="lg"
                  radius={999}
                  tint="#ffffff"
                  tintOpacity={0.02}
                  textColor="#b5a79c"
                  lineColor="#fff4e8"
                  baseColor="#3a312b"
                  intensity={0.8}
                  idleIntensity={0.25}
                >
                  <Github className="h-4 w-4" />
                  <span>GitHub</span>
                </SpecularButton>
              </div>
            </div>

            <div class="flex items-center justify-center lg:col-span-5">
              <VideoShowcase client:load />
            </div>
          </div>
        </section>
      </div>
    </div>

    <main>
      <!-- ScrollExpand Showcase with Brand Demo Video -->
      <section class="mx-auto max-w-6xl px-6 py-10">
        <ScrollExpand
          client:visible
          src="/brand/raygan-unscripted-loop.mp4"
          mediaType="video"
          title="Every peak, captured."
          scrollHint="Scroll to expand"
          startWidth={52}
          startHeight={62}
          scrollDistance={0.9}
          holdDistance={0.2}
          useWindowScroll
        >
          <h2 class="font-serif text-4xl text-white sm:text-5xl">
            Word-level captions. Instant framing.
          </h2>
          <p class="mt-3 max-w-lg text-sm text-zinc-200 sm:text-base">
            Rendered locally with FFmpeg, librosa energy peaks, and your choice of AI hook scoring.
          </p>
        </ScrollExpand>
      </section>

      <!-- CurvedLoop Platforms & AI Providers Marquee -->
      <section class="border-y border-[#fff4e8]/8 bg-[#120d0a]/80">
        <CurvedLoop
          client:visible
          marqueeText="YOUTUBE ✦ TWITCH ✦ KICK ✦ SHORTS ✦ REELS ✦ TIKTOK ✦ GEMINI ✦ OLLAMA ✦ OPENAI ✦ CLAUDE ✦ GROQ"
          shape="arc"
          speed={1.4}
          curveAmount={150}
          fontSize={42}
          fontWeight={700}
          color="#b5a79c"
          separatorColor="#ff7a2f"
          edgeFade={0.35}
        />
      </section>

      <!-- Key Metrics -->
      <section class="mx-auto max-w-6xl px-6 py-24">
        <InView client:visible>
          <div class="grid grid-cols-1 gap-px overflow-hidden rounded-2xl border border-[#fff4e8]/10 bg-[#fff4e8]/10 sm:grid-cols-3">
            <div class="bg-[#120d0a] p-8 sm:p-10">
              <div class="font-serif text-5xl tracking-tight text-[#fbf7f2]">
                <CountUp client:visible to={100} suffix="%" />
              </div>
              <p class="mt-3 text-sm leading-relaxed text-[#b5a79c]">
                Self-hosted and MIT-licensed. No subscriptions, watermarks, or per-minute fees.
              </p>
            </div>
            <div class="bg-[#120d0a] p-8 sm:p-10">
              <div class="font-serif text-5xl tracking-tight text-[#ff7a2f]">
                <CountUp client:visible to={8} suffix="+" />
              </div>
              <p class="mt-3 text-sm leading-relaxed text-[#b5a79c]">
                AI providers supported: Gemini, Ollama, OpenAI, Claude, Groq, Grok, and OpenRouter.
              </p>
            </div>
            <div class="bg-[#120d0a] p-8 sm:p-10">
              <div class="font-serif text-5xl tracking-tight text-[#fbf7f2]">
                <CountUp client:visible to={3} />
              </div>
              <p class="mt-3 text-sm leading-relaxed text-[#b5a79c]">
                Instant aspect ratios (<code class="font-mono text-[#fbf7f2]">9:16</code>,{" "}
                <code class="font-mono text-[#fbf7f2]">1:1</code>,{" "}
                <code class="font-mono text-[#fbf7f2]">16:9</code>) with word-level ASS captions.
              </p>
            </div>
          </div>
        </InView>
      </section>

      <!-- Connected Studio Pipeline Bento -->
      <StudioPipeline client:visible />

      <!-- Quick Start + FAQ with AnimatedContent -->
      <AnimatedContent client:visible distance={60} duration={0.8} stagger={0.12}>
        <section id="quickstart" class="mx-auto max-w-6xl px-6 py-20">
          <div class="relative overflow-hidden rounded-3xl border border-[#fff4e8]/12 bg-[#15100d] p-8 sm:p-12">
            <BorderTrail client:visible />
            <div class="relative z-10 grid gap-10 lg:grid-cols-2 lg:items-center">
              <div>
                <div class="inline-flex items-center gap-2 font-mono text-xs font-semibold text-[#ff7a2f] uppercase">
                  <Terminal className="h-4 w-4" />
                  <span>Quick Start</span>
                </div>
                <h2 class="mt-3 font-serif text-3xl tracking-tight text-[#fbf7f2] sm:text-4xl">
                  Up and running in three commands.
                </h2>
                <p class="mt-4 text-sm leading-relaxed text-[#b5a79c]">
                  Requires Python 3.10+ (FFmpeg bundles automatically via{" "}
                  <code class="font-mono text-[#fbf7f2]">static-ffmpeg</code>). Or launch the
                  full stack with <code class="font-mono text-[#fbf7f2]">docker compose up -d --build</code>.
                </p>
                <div class="mt-6">
                  <a
                    href="/docs/quickstart"
                    class="inline-flex items-center gap-2 text-sm font-semibold text-[#ff7a2f] transition-colors hover:text-[#ff904d]"
                  >
                    <span>Full installation and Docker guide</span>
                    <ArrowRight className="h-4 w-4" />
                  </a>
                </div>
              </div>

              <div class="overflow-x-auto rounded-2xl border border-[#fff4e8]/10 bg-[#0d0a08] p-6 font-mono text-xs leading-7 text-[#e4dad0] sm:text-sm">
                <div><span class="text-[#786b61]"># Clone into a short path (e.g. C:\clipcut or ~/clipcut)</span></div>
                <div>git clone https://github.com/Chethankumar443/ClipCut.git ~/clipcut</div>
                <div>cd ~/clipcut &amp;&amp; pip install -r requirements.txt</div>
                <div class="text-[#ff9a5c]">python -m studio.server</div>
              </div>
            </div>
          </div>
        </section>

        <section id="faq" class="mx-auto max-w-3xl px-6 py-20">
          <div class="mb-10 text-center">
            <h2 class="font-serif text-4xl tracking-tight text-[#fbf7f2]">Frequently asked questions</h2>
            <p class="mt-3 text-sm text-[#b5a79c]">
              Everything you need to know about running ClipCut locally.
            </p>
          </div>
          <FaqAccordion client:visible />
        </section>
      </AnimatedContent>
    </main>

    <Footer client:visible />
  </div>
</Layout>
